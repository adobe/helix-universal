{
  "name": "@adobe/helix-universal",
  "version": "5.4.3",
  "description": "Helix Universal",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./google": "./src/google-adapter.js",
    "./aws": "./src/aws-adapter.js",
    "./openwhisk": "./src/openwhisk-adapter.js"
  },
  "scripts": {
    "test": "c8 mocha --spec=test/**/*.test.js",
    "lint": "eslint .",
    "semantic-release": "semantic-release",
    "semantic-release-dry": "semantic-release --dry-run --branches $CI_BRANCH",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/helix-universal.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/adobe/helix-universal/issues"
  },
  "mocha": {
    "recursive": "true",
    "reporter": "mocha-multi-reporters",
    "reporter-options": "configFile=.mocha-multi.json",
    "loader": "esmock",
    "require": [
      "test/setup-env.js",
      "mocha-suppress-logs"
    ]
  },
  "homepage": "https://github.com/adobe/helix-universal#readme",
  "dependencies": {
    "@adobe/fetch": "4.3.1",
    "aws4": "1.13.2"
  },
  "devDependencies": {
    "@adobe/eslint-config-helix": "3.0.30",
    "@eslint/config-helpers": "0.7.0",
    "@google-cloud/secret-manager": "7.0.0",
    "@google-cloud/storage": "8.0.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "aws-sdk": "2.1693.0",
    "c8": "12.0.0",
    "eslint": "9.39.5",
    "esmock": "2.7.6",
    "husky": "9.1.7",
    "junit-report-builder": "5.1.2",
    "lint-staged": "17.3.0",
    "mocha": "11.8.0",
    "mocha-multi-reporters": "^1.5.1",
    "mocha-suppress-logs": "0.6.0",
    "nock": "14.0.17",
    "semantic-release": "25.0.9"
  },
  "lint-staged": {
    "*.js": "eslint"
  }
}
